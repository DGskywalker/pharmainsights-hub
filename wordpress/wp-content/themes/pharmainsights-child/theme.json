{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "color": "#0a2540",
          "name": "Navy Primary",
          "slug": "primary"
        },
        {
          "color": "#008080",
          "name": "Teal Secondary",
          "slug": "secondary"
        },
        {
          "color": "#005a9c",
          "name": "Clinical Blue",
          "slug": "accent"
        },
        {
          "color": "#1e293b",
          "name": "Slate Dark",
          "slug": "neutral-dark"
        },
        {
          "color": "#f8fafc",
          "name": "Slate Light",
          "slug": "neutral-light"
        },
        {
          "color": "#ffffff",
          "name": "White Surface",
          "slug": "surface"
        },
        {
          "color": "#d97706",
          "name": "Amber Alert",
          "slug": "warning"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        }
      ],
      "fontSizes": [
        {
          "fluid": {
            "max": "0.95rem",
            "min": "0.85rem"
          },
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "fluid": {
            "max": "1.125rem",
            "min": "1rem"
          },
          "name": "Medium (Body)",
          "size": "1.05rem",
          "slug": "medium"
        },
        {
          "fluid": {
            "max": "1.45rem",
            "min": "1.25rem"
          },
          "name": "Large (H3)",
          "size": "1.35rem",
          "slug": "large"
        },
        {
          "fluid": {
            "max": "2.2rem",
            "min": "1.75rem"
          },
          "name": "Extra Large (H2)",
          "size": "1.85rem",
          "slug": "x-large"
        },
        {
          "fluid": {
            "max": "3rem",
            "min": "2.25rem"
          },
          "name": "Hero (H1)",
          "size": "2.5rem",
          "slug": "xx-large"
        }
      ]
    },
    "layout": {
      "contentSize": "820px",
      "wideSize": "1200px"
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vh", "vw"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--surface)",
      "text": "var(--wp--preset--color--neutral-dark)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system-sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary)"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.25"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      }
    }
  }
}
